<%@ page contentType="text/html;charset=UTF-8" language="java" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Secure RBAC - Setup MFA</title>
    <link rel="stylesheet" href="${pageContext.request.contextPath}/css/style.css">
</head>
<body>
<div class="dashboard-container">
    <div class="table-card" style="max-width: 600px; margin: 4rem auto; padding: 2rem;">
        <div class="welcome-section text-center">
            <h1>Setup Two-Factor Authentication</h1>
            <p class="auth-subtitle mb-6">Enhance your account security by enabling MFA.</p>
        </div>

        <c:if test="${not empty requestScope.error}">
            <div class="alert alert-error">
                <strong>Error:</strong> ${requestScope.error}
            </div>
        </c:if>

        <div style="background: var(--bg-base); padding: 1.5rem; border-radius: var(--radius-md); text-align: center; margin-bottom: 2rem;">
            <p class="mb-4 text-sm text-secondary">
                1. Install an authenticator app like Google Authenticator or Authy.<br>
                2. Add a new account manually by entering the secret key below.
            </p>
            <div style="font-family: monospace; font-size: 1.5rem; letter-spacing: 2px; font-weight: bold; padding: 1rem; background: white; border: 1px solid var(--border); border-radius: var(--radius-sm); color: var(--primary);">
                ${requestScope.mfaSecret}
            </div>
        </div>

        <form action="${pageContext.request.contextPath}/mfa-setup" method="post" class="auth-form">
            <div class="form-group">
                <label for="mfaCode">3. Enter the 6-digit code generated by your app to verify setup:</label>
                <input type="text" id="mfaCode" name="mfaCode" placeholder="000000" 
                       pattern="[0-9]{6}" maxlength="6" autocomplete="off" required>
            </div>

            <div class="flex gap-4">
                <a href="${pageContext.request.contextPath}/profile" class="btn btn-outline" style="flex: 1;">Cancel</a>
                <button type="submit" class="btn btn-primary" style="flex: 2;">Verify and Enable</button>
            </div>
        </form>
    </div>
</div>
</body>
</html>
